{
	"plugin": ["typedoc-plugin-markdown"],
	"out": "./tempdocs",
	"entryPoints": ["lib/index.ts"],
	"cleanOutputDir": true,
	"readme": "none",
	"headings": {
		"readme": false,
		"document": false
	},
	"hidePageHeader": true,
	"hideBreadcrumbs": true,
	"useCodeBlocks": true,
	"expandObjects": true,
	"expandParameters": true,
	"strikeDeprecatedPageTitles": false,
	"propertiesFormat": "table",
	"parametersFormat": "table",
	"disableSources": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"excludeTags": ["@overload"],
	"pageTitleTemplates": {
		"member": "{name}"
	},
	"externalSymbolLinkMappings": {
		"@jsfkit/types": {
			"Workbook": "https://jsfkit.github.io/types/Workbook"
		}
	}
}
