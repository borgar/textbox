{
  "include": [
     "lib/**/*",
  ],
  "compilerOptions": {
    "rootDir": "lib",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "stripInternal": true,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "outDir": "types",
    "declarationMap": false,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true 
  }
}
